{
  "name": "dsh-client-ui-aqua",
  "version": "0.1.0",
  "description": "DeepSeek Harness 水色（Aqua）主题插件：把品牌蓝强调色整体换成水色/青绿，浅深两种模式各给一套值，可在「设置 → 通用」一键开关。",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "author": "dsh-client-ui-aqua contributors",
  "scripts": {
    "build": "tsdown"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "aqua",
    "accent-color"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-store"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
