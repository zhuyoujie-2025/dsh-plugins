{
  "name": "dsh-composer-bottom-seal",
  "version": "0.1.0",
  "description": "Remove the conversation composer's bottom clearance so wallpaper cannot leak below the final status row.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown && node scripts/verify-bundle.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "devDependencies": {
    "tsdown": "^0.22.14"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "url": "git+https://github.com/zhuyoujie-2025/dsh-plugins.git",
    "directory": "dsh-composer-bottom-seal"
  }
}
